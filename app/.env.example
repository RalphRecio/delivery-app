# Only EXPO_PUBLIC_* variables reach the app bundle. Validated in src/config/env.ts.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Web: same-origin path proxied by the dev server to the API (metro.config.js).
# Lets the web app work through a tunnel or on another device without CORS.
EXPO_PUBLIC_WEB_API_URL=/api/v1
